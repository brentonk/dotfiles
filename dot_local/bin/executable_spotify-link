#!/bin/sh
# spotify-link — handle a spotify: URI, then surface the already-running
# Spotify instance in the active compositor.
#
# Wired up as the x-scheme-handler/spotify handler (see the spotify.desktop
# alongside this script). Without this, clicking a Spotify link in the browser
# silently navigates the already-running Spotify window and you never see it.
#
# Compositor handling:
#   niri — focus Spotify's window, which carries you to whatever workspace
#          holds it.
#   sway — show it from the dedicated scratchpad (the previous daily driver's
#          setup; kept for hosts still on sway).
# On any other host this just launches/navigates Spotify.

uri="$1"

# Was an instance already running before we dispatched the URI? A fresh launch
# opens a window on the active workspace (niri) or is surfaced by the
# `for_window ... scratchpad show` rules (sway), so we only need to surface an
# *existing* instance ourselves.
running=false
pgrep -x spotify >/dev/null 2>&1 && running=true

# Hand the URI to Spotify: launches a new instance, or navigates the existing
# single instance and exits.
setsid spotify --uri="$uri" >/dev/null 2>&1 &

# Surface only for an already-running instance.
[ "$running" = true ] || exit 0

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# A handler launched by the desktop portal (e.g. a browser click on a spotify:
# link) runs under systemd/D-Bus, which exports WAYLAND_DISPLAY but not the
# compositor IPC socket vars (NIRI_SOCKET / SWAYSOCK) — and the msg clients
# can't always auto-discover them. Fall back to the socket file each
# compositor leaves in XDG_RUNTIME_DIR (newest wins if a stale one lingers).

# --- niri ---
if [ -z "$NIRI_SOCKET" ]; then
  NIRI_SOCKET=$(ls -t "$runtime_dir"/niri.*.sock 2>/dev/null | head -n1)
  export NIRI_SOCKET
fi
if [ -n "$NIRI_SOCKET" ] && windows=$(niri msg --json windows 2>/dev/null); then
  # Native Wayland builds expose app_id="spotify"; Xwayland builds (via
  # xwayland-satellite) expose app_id="Spotify" from the X11 class — match
  # case-insensitively to cover both.
  id=$(printf '%s' "$windows" | jq -r '
    [ .[] | select((.app_id // "") | ascii_downcase == "spotify") | .id ]
    | first // empty')
  [ -n "$id" ] && niri msg action focus-window --id "$id" >/dev/null 2>&1
  exit 0
fi
# NIRI_SOCKET may point at a stale socket from a dead session; if niri msg
# failed above, fall through and try sway.

# --- sway ---
if [ -z "$SWAYSOCK" ]; then
  SWAYSOCK=$(ls -t "$runtime_dir"/sway-ipc.*.sock 2>/dev/null | head -n1)
  export SWAYSOCK
fi
[ -n "$SWAYSOCK" ] || exit 0

# Match Spotify by either identifier: native Wayland builds expose
# app_id="spotify" with a null class, while Xwayland builds expose
# class="Spotify" with a null app_id. The two are mutually exclusive, so
# handling both covers every host.
#
# Show the scratchpad window only if it isn't already on screen — `scratchpad
# show` toggles, so acting unconditionally would hide a visible Spotify.
visible=$(swaymsg -t get_tree 2>/dev/null | jq -r '
  [ recurse(.nodes[]?, .floating_nodes[]?)
    | select(.app_id? == "spotify" or .window_properties.class? == "Spotify")
    | .visible ] | first // empty')

if [ "$visible" != "true" ]; then
  swaymsg '[app_id="spotify"] scratchpad show' >/dev/null 2>&1
  swaymsg '[class="Spotify"] scratchpad show' >/dev/null 2>&1
fi
